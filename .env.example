# Copy to .env. Everything else can be set from the dashboard's Secrets page later.

# --- required ---------------------------------------------------------------
GROQ_KEY=gsk_...                          # console.groq.com, free tier works
GROQ_MODEL=openai/gpt-oss-120b

# --- deployment -------------------------------------------------------------
PUBLIC_URL=https://press.example.com      # the Cloudflare tunnel hostname (no trailing slash)
DJANGO_ALLOWED_HOSTS=press.example.com,localhost,127.0.0.1
DJANGO_DEBUG=0
# DJANGO_SECRET_KEY is generated on first start and written here automatically

# --- optional integrations (all free) -------------------------------------
GOOGLE_CLIENT_ID=                         # OAuth web client; redirect URI = $PUBLIC_URL/api/google/callback
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=                           # PageSpeed Insights API
PEXELS_KEY=                               # stock photos for featured images
